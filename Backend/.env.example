# Application Settings
PROJECT_NAME="Waste Classification API"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000

# CORS
# Comma-separated allowed origins or JSON list
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database
# Default: Local SQLite with async driver. For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/wastedb
DATABASE_URL="sqlite+aiosqlite:///./waste_classification.db"

# Storage
UPLOAD_DIR="./app/static/uploads"
MAX_UPLOAD_SIZE_MB=15

# Machine Learning Model Configuration
# Path to custom weights (e.g., ./models/waste_classifier.onnx or .pt). If not found, falls back to built-in inference engine.
MODEL_PATH="./models/waste_classifier.onnx"
CONFIDENCE_THRESHOLD=0.60
